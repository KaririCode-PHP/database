{
    "name": "kariricode/database",
    "description": "SQL Database Abstraction Layer (DBAL) for the KaririCode ecosystem — driver-agnostic connections, middleware pipeline, query builder, platform dialects, type system, result caching, and semantic exceptions.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.11",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "suggest": {
        "ext-pdo_mysql": "Required for MySQL/MariaDB support",
        "ext-pdo_pgsql": "Required for PostgreSQL support",
        "ext-pdo_sqlite": "Required for SQLite support",
        "kariricode/cache": "A PSR-16 cache for executeCacheQuery()",
        "kariricode/logging": "A PSR-3 logger for LoggingMiddleware",
        "kariricode/event-dispatcher": "A PSR-14 dispatcher for connection and query events"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\Database\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\Database\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-conformance": "phpunit --testsuite Conformance",
        "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
        "psalm": "psalm --no-cache --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "complexity": "php tools/complexity.php src",
        "infection": "infection --min-msi=80 --min-covered-msi=80 --threads=max",
        "security": [
            "@composer validate --strict",
            "@composer audit",
            "php tools/secret-scan.php"
        ],
        "sbom": "php tools/sbom.php > sbom.cdx.json",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@infection",
            "@security"
        ]
    },
    "extra": {
        "kariricode": {
            "component": "database",
            "spec": "4.3.3",
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 1
            },
            "error-code-range": "6000–6199"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "infection/infection": "^0.29",
        "nikic/php-parser": "^5.4",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "vimeo/psalm": "^6.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
